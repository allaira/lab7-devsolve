-
  var navItems = [
    { name: "Проєкти", icon: "bi-check2-square", active: true },
    { name: "Команда", icon: "bi-people", active: false },
    { name: "Звіти", icon: "bi-file-earmark-text", active: false }
  ]

//- Cookie
.cookie-banner#cookie-banner
  .cookie-left
    i.bi.bi-cookie.cookie-icon
    span.cookie-text Ми використовуємо cookie, щоб зробити роботу в DevSolve зручнішою. 
    a.cookie-link(href="#") Детальніше
  .cookie-actions
    button.btn-cookie-outline Параметри
    button#cookie-accept.btn-cookie-dark Згодитися

//- Верхня шапка з генерацією меню через цикл each
header.top-header
  .header-left
    .brand
      .brand-logo
        i.bi.bi-layers-fill
      .brand-titles
        h1.brand-name DevSolve
        span.brand-desc Робочий простір команди
    nav.nav-menu
      each item in navItems
        button.nav-item(class=item.active ? "active" : "")
          i.bi(class=item.icon)
          span= item.name

  .header-right
    .role-switcher(style="display: flex; align-items: center; gap: 8px; margin-right: 12px;")
      label(style="color: #C2C7CF; font-size: 12px;") Роль:
      select#role-select(style="background: #302F33; color: #fff; border: 1px solid #636D79; border-radius: 6px; padding: 4px 8px; font-size: 12px;")
        option(value="pm" selected) Менеджер (PM)
        option(value="dev") Розробник
    .search-box
      i.bi.bi-search
      input#search-input(type="text" placeholder="Пошук завдань або тегів...")
    button.btn-icon
      i.bi.bi-bell
    .user-pill
      img.user-avatar-circle(src="/p1.jpg" alt="Ірина Коваль")
      span.user-fullname Ірина Коваль
      i.bi.bi-chevron-down