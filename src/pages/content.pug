.main-wrapper
  //- Ліва бічна панель
  aside.sidebar
    .project-card
      .card-header-row
        span.badge-sub ПОТОЧНИЙ ПРОЄКТ
        button#btn-passport.dots-btn(type="button" title="Паспорт проєкту")
          i.bi.bi-three-dots
      h2#project-name-display Назва проєкту
      hr.card-divider
      .manager-row
        span.manager-label Менеджер
        .manager-person
          img.avatar-sm(src="/p1.jpg" alt="Ірина Коваль")
          span.manager-name Ірина Коваль

    //- US 3: Документація проєкту
    .sidebar-section-title(style="display: flex; justify-content: space-between; align-items: center;")
      span ДОКУМЕНТАЦІЯ
      button#btn-upload-doc(type="button" style="background:none; border:none; color:#C2C7CF; font-size:11px; cursor:pointer;") + Додати
    input#doc-upload-input(type="file" style="display: none")
    #docs-list(style="margin-bottom: 16px;")

    //- US 2: Етапи проєкту
    .sidebar-section-title(style="display: flex; justify-content: space-between; align-items: center;")
      span ЕТАПИ ПРОЄКТУ
      button#btn-add-stage(type="button" style="background:none; border:none; color:#C2C7CF; font-size:11px; cursor:pointer;") + Етап
    .phases-card#stages-list

    //- US 4: Команда проєкту
    .sidebar-section-title(style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px;")
      span КОМАНДА
      button#btn-add-member(type="button" style="background:none; border:none; color:#C2C7CF; font-size:11px; cursor:pointer;") + Учасник
    #team-list(style="margin-bottom: 16px;")

    //- US 10: Фінанси та бюджет етапу (лише для PM)
    #pm-budget-box.total-progress-box(style="margin-top: 14px;")
      .tp-row
        span.tp-title Бюджет етапу
        span#budget-planned.tp-stat 120 000 грн
      .tp-row(style="margin-top: 4px;")
        span(style="font-size: 11px; color: #C2C7CF;") Фактичні витрати:
        span#budget-spent(style="font-size: 11px; color: #fff;") 0 грн
      .tp-row(style="margin-top: 4px;")
        span(style="font-size: 11px; color: #C2C7CF;") Залишок:
        span#budget-remaining(style="font-size: 12px; font-weight: bold; color: #4cd964;") 120 000 грн

  //- Центральна дошка завдань
  section.board-area
    .board-header
      .board-header-left
        span.sprint-tag РОЗРОБКА • СПРИНТ 1
        h2.board-title Дошка завдань
      .board-header-right
        button.btn-circle(type="button")
          i.bi.bi-star
        button.btn-circle(type="button")
          i.bi.bi-sliders
        //- US 5: Створення завдання
        button#btn-create-task.btn-create(type="button") ＋ Створити

    .board-toolbar
      .toolbar-left
        span.badge-deadline Дедлайн: 15 листопада
        span#sprint-count.sprint-count 4 завдань у спринті
      button.btn-filter(type="button")
        i.bi.bi-funnel
        span Фільтри

    //- Усі колонки та картки тепер автоматично створює TypeScript через innerHTML
    .kanban-grid#kanban-grid

    //- Нижня панель кнопок усередині дошки (залишилась без змін)
    .board-bottom-bar
      .bottom-nav-left
        a.tab-item(href="#")
          i.bi.bi-inbox
          span Вхідні
        a.tab-item(href="#")
          i.bi.bi-calendar3
          span Календар
        a.tab-item(href="#")
          i.bi.bi-stack
          span Всі дошки
      .bottom-nav-right
        a.tab-item.active(href="#")
          i.bi.bi-kanban
          span Дошка

  //- Права колонка деталей
  .right-column
    aside.details-panel
      .details-top-bar
        .details-titles
          span#details-task-id.task-code ЗАВДАННЯ TASK-101
          h2.details-heading Деталі, ТЗ та облік часу
        button.btn-close-panel(type="button")
          i.bi.bi-x-lg

      .status-card-block
        //- US 7: Селект зміни статусу
        span.field-tag СТАТУС
        select#status-select.theme-input(style="width: 100%; margin-bottom: 10px; background: #302F33; color: #fff; border: 1px solid #636D79; border-radius: 6px; padding: 6px;")
          option(value="todo") До виконання
          option(value="in_progress") В процесі
          option(value="review") На перевірці
          option(value="done") Виконано

        //- US 6: Селект призначення виконавця
        span.field-tag ВИКОНАВЕЦЬ
        select#assignee-select.theme-input(style="width: 100%; margin-bottom: 12px; background: #302F33; color: #fff; border: 1px solid #636D79; border-radius: 6px; padding: 6px;")

        //- US 8: Оцінка та залишок
        .time-stats-grid
          .stat-card-item
            span.stat-label Оцінка
            span#details-estimate.stat-value 16 год
          .stat-card-item
            span.stat-label Залишилось
            span#details-remaining.stat-value 8 год

      .panel-section
        h3.panel-section-title Опис і вимоги
        p#details-desc.req-description На основі ТЗ, реалізувати форму обліку відпрацьованих годин.
        .attachment-chip
          i.bi.bi-paperclip
          span Технічне_завдання_МедЛаб_v2.pdf

      hr.panel-divider

      //- US 8 та US 9: Внесення годин з лімітом 10 год/день
      .panel-section
        h3.panel-section-title Внести години
        .hours-inputs-row
          .input-group
            label.input-label Дата
            input#log-date.theme-input(type="date")
          .input-group
            label.input-label Години
            input#log-hours.theme-input(type="number" step="0.1" min="0.1" max="10" placeholder="1-10")
        .input-group(style="margin-top: 8px;")
          input#log-comment.theme-input(type="text" placeholder="Коментар до виконаної роботи...")
        span.hint-limit Максимум 10 годин на день
        button#btn-save-log.btn-submit-log(type="button") Зберегти години в журнал

      hr.panel-divider

      //- Журнал історії
      .panel-section
        .history-header-row
          span.panel-section-title Історія
          a.history-link(href="#") Уся історія
        #history-list

    .status-capsule
      span Документація API • Стабільність 99.8% • 
      span.status-online ● Онлайн

#project-modal.modal-overlay
  .modal-dialog
    .modal-header
      span.badge-sub ПАСПОРТ ПРОЄКТУ
      h2.modal-title Створення нового проєкту
      p.modal-desc Заповніть форму паспорта для запуску робочого простору DevSolve
    
    form#project-form
      .modal-field
        label.modal-label(for="proj-input-name") Назва проєкту *
        input#proj-input-name.theme-input(type="text" placeholder="Наприклад: Система діагностики «МедЛаб»" value="Система лабораторної діагностики «МедЛаб»" required)

      .modal-field
        label.modal-label(for="proj-input-client") Замовник
        input#proj-input-client.theme-input(type="text" placeholder="Замовник робіт" value="Міська клінічна лікарня")

      .modal-row
        .modal-field
          label.modal-label(for="proj-input-start") Дата старту *
          input#proj-input-start.theme-input(type="date" value="2026-10-01" required)
        .modal-field
          label.modal-label(for="proj-input-deadline") Дедлайн
          input#proj-input-deadline.theme-input(type="date" value="2026-12-31")

      .modal-field
        label.modal-label(for="proj-input-desc") Короткий опис (до 500 символів)
        textarea#proj-input-desc.theme-input(rows="3" placeholder="Опишіть мету та задачі...") Розробка вебплатформи для автоматизації обліку лабораторних досліджень.

      button#btn-submit-project.btn-submit-log(type="submit" style="margin-top: 14px; width: 100%;") Створити та відкрити проєкт